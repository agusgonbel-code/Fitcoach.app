{
  "name": "fitcoach-app",
  "version": "3.4.4",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "sync:web": "node scripts/sync-web.mjs",
    "audit": "node scripts/audit.mjs",
    "cap:sync": "npm run sync:web && cap sync",
    "cap:add:ios": "npm run sync:web && cap add ios && npm run ios:assets",
    "cap:open:ios": "cap open ios",
    "ios:assets": "node scripts/configure-ios-assets.mjs",
    "ios:prepare": "npm run sync:web && cap sync ios && npm run ios:assets",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0"
  }
}
